# Flask Application Secret Key
SECRET_KEY=your_secure_random_secret_key

# Database Connection (Leave empty or omitted to use local SQLite instance/exam_portal.db)
DATABASE_URL=postgresql://username:password@localhost:5432/exam_portal

# Admin Security PIN for admin panel actions
ADMIN_SECURITY_PIN=0007

# Brevo SMTP Configuration for Admin Exam Submission Notifications
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_brevo_smtp_username
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_DEFAULT_SENDER=aniket@aiqmindia.com
EXAM_SUBMISSION_NOTIFICATION_RECIPIENTS=aniket@aiqmindia.com,dskode@aiqmindia.com,edu@aiqmindia.com,ravi.k@aiqmindia.com
